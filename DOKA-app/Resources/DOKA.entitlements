<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Права для подписи Developer ID (hardened runtime — обязателен для нотаризации).
  Под hardened runtime микрофон и камера без этих ключей молча отдают тишину и
  чёрный кадр, а системный запрос разрешения даже не показывается.
  Подпись «DOKA Dev» и ad-hoc идут без hardened runtime, им файл не нужен.
-->
<plist version="1.0">
<dict>
	<!-- Запись диктовки -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Эксперимент «Губы» -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
